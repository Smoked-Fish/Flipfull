{
  "name": "Voice Assistant",
  "short_name": "KaiVA",
  "description": "Kai Voice Assistant: voice commands and dictation, recognized on the phone.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/index.html#voice-assistant",
  "orientation": "natural",
  "theme_color": "#000000",
  "background_color": "transparent",
  "icons": [
    { "src": "/img/kaivoice_assistant_56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/img/kaivoice_assistant_112.png", "type": "image/png", "sizes": "112x112" },
    { "src": "/img/kaivoice_assistant_224.png", "type": "image/png", "sizes": "224x224" }
  ],
  "b2g_features": {
    "version": "3.2.1",
    "origin": "kaios-voiceassistant",
    "core": true,
    "focus_color": "#8000ff",
    "developer": { "name": "local" },
    "serviceworker": { "script_url": "sw.js" },
    "permissions": {
      "audio-capture": { "description": "Hears what you say, it is turned into text on the phone" },
      "settings": { "access": "readwrite", "description": "Wi-Fi, mobile data, airplane mode and the voice app choice" },
      "contacts": { "access": "readonly", "description": "Call and text contacts by name" },
      "bluetooth": { "description": "Turn Bluetooth on and off" },
      "flashlight": { "description": "Turn the flashlight on and off" }
    },
    "activities": {
      "voice-input": { "returnValue": true },
      "voice-assistant": { "returnValue": false }
    }
  }
}
