{"name":"E-Mail","short_name":"E-Mail","lang":"en-US","description":"Gaia E-Mail","start_url":"/index.html","theme_color":"rgb(255, 255, 255)","orientation":"natural","icons":[{"src":"/style/icons/email_56.png","type":"image/png","sizes":"56x56"},{"src":"/style/icons/email_112.png","type":"image/png","sizes":"112x112"}],"b2g_features":{"focus_color":"#842dff","version":"1.0","core":true,"chrome":{"statusbar":"overlap"},"permissions":{"alarms":{},"audio-channel-notification":{},"contacts":{"access":"readwrite"},"desktop-notification":{},"settings":{"access":"readwrite"},"downloads":{},"device-storage:sdcard":{"access":"readcreate"},"systemXHR":{},"tcp-socket":{},"engmode":{},"mobileconnection":{},"power":{},"account-manager":{},"account-observer-activesync":{},"account-observer-google":{},"webapps-manage":{}},"messages":["alarm","notification"],"activities":{"new":{"filters":{"type":"mail"},"returnValue":true},"share":{"filters":{"type":["audio/*","image/*","url","video/*","application/*","text/vcard","text/*"]},"returnValue":true},"view":{"filters":{"type":"url","url":{"required":true,"pattern":"mailto:.{1,16384}"}},"returnValue":true}},"serviceworker":{"script_url":"/sw_system_message.js"}}}