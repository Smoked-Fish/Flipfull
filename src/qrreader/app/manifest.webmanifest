{
  "name": "QR Reader",
  "short_name": "QR Reader",
  "description": "Reads QR codes with the camera or from a photo: links, Wi-Fi networks, contacts, phone numbers.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/index.html",
  "orientation": "natural",
  "theme_color": "#000000",
  "background_color": "#000000",
  "icons": [
    { "src": "/img/qrreader_56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/img/qrreader_112.png", "type": "image/png", "sizes": "112x112" }
  ],
  "b2g_features": {
    "version": "1.0.0",
    "origin": "qrreader",
    "focus_color": "#8000ff",
    "developer": { "name": "local" },
    "categories": ["utilities"],
    "permissions": {
      "camera": { "description": "See the QR code" },
      "video-capture": { "description": "See the QR code" },
      "wifi-manage": { "description": "Join a Wi-Fi network from its QR code" }
    }
  }
}
