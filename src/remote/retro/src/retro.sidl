dictionary Failure {
  message: str
  offline: bool
}

dictionary Game {
  width: int
  height: int
  frame_ns: int
  rate: int
}

#[rust:not-tracked]
interface Retro {
  fn info() -> json

  fn stream() -> str, Failure

  fn games() -> json, Failure

  fn load(path: str) -> Game, Failure

  fn reset() -> void, Failure

  fn states() -> json, Failure

  fn save_state(slot: int) -> void, Failure

  fn load_state(slot: int) -> void, Failure

  fn settings() -> json

  fn set(key: str, value: json) -> json, Failure

  fn unload()
}

service FlipfullRetro: Retro
