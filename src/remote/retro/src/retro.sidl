dictionary Failure {
  message: str
  offline: bool
}

dictionary Game {
  width: int
  height: int
  frame_ns: int
  rate: int
}

#[rust:not-tracked]
interface Retro {
  fn info() -> json

  fn stream() -> str, Failure

  fn load(rom: binary, save: binary) -> Game, Failure

  fn save() -> binary, Failure

  fn unload()
}

service FlipfullRetro: Retro
