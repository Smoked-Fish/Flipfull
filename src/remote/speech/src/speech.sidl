dictionary Failure {
  message: str
  offline: bool
}

#[rust:not-tracked]
interface Speech {
  fn open() -> bool

  fn close()

  fn health() -> json

  fn models() -> json

  fn use_model(file: str) -> json, Failure

  fn download(file: str, offset: int, piece: binary) -> json, Failure

  fn delete_model(file: str) -> json, Failure

  fn begin()

  fn append(audio: binary) -> void, Failure

  fn transcribe() -> json, Failure
}

service FlipfullSpeech: Speech
