#!/system/bin/sh

usage() {
    cat <<'EOF'
flipfull - turns Flipfull's features on and off, and installs, updates and
removes Flipfull.

  flipfull features               the feature list (features.ini)
  flipfull state                  each feature: on / off, at the last UI start, usable on this phone,
                                  what waits for the UI to restart
  flipfull list                   each feature in its section, with its title
  flipfull set ID on|off ...      turn features on / off, then the state
  flipfull plan                   what the features that are on need
  flipfull removable [install|uninstall NAME...]
  flipfull google-client [import [FILE] | remove]
                                  your own Google sign-in client
  flipfull status                 a summary to read (flip4.py status)
  flipfull log [LINES]            the boot log
  flipfull restart [APP...]       restart the UI (b2g and api-daemon, applying what waits for it),
                                  or only those apps
  flipfull reboot
  flipfull install-app ZIP        install an application.zip through api-daemon
  flipfull setup [--from DIR]     install or update from DIR, a copy of
                                  userinit/ with .files listing it
  flipfull update start TAG ASSET SHA256
                                  download that release asset from
                                  RELEASE_REPO, check it and install it, in
                                  the background
  flipfull update [status]        how the last update went
  flipfull store stage URL [SHA256] | stage-file  ZIP | install ORIGIN SOURCE
                                    | install-pwa URL | uninstall NAME | installed
                                  what OStore asks for (ostore feature)
  flipfull uninstall [--reboot]   remove Flipfull; the next boot finishes it
EOF
}

HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib/common.sh"
LOG_TAG=
load_needs

SET_LOCK=$STATE/set.lock
SYSTEM_WEBAPPS=/system/b2g/webapps
APPS_WAITING=$STATE/apps-waiting
APPS_APPLYING=$STATE/apps-applying
GOOGLE_CLIENT=$CONFIG/google-client.json
GOOGLE_REDIRECT=http://localhost/redirect/loginpages/redirect.html
RELEASE_REPO=Smoked-Fish/Flipfull
UPDATE_DIR=/data/local/tmp/flipfull-update

# printf isn't built into the phone's sh, each one is a process
availability() {
    overlays_read
    needs | awk '{ print $2, $3 }' | sort -u | while read -r kind name; do
        echo -n "$kind $name "
        "${kind}_status" "$name"
    done
}

# a UI restart and a reboot start it again
cached_availability() {
    read -r boot < /proc/sys/kernel/random/boot_id
    key="# $boot $(stat -c %Y "$MANIFEST" "$REMOTE_REGISTRY" 2>/dev/null | tr '\n' ' ')"
    first=
    [ -f "$STATE/avail" ] && IFS= read -r first < "$STATE/avail"
    [ "$first" = "$key" ] && return 0
    # a state can run while a set does
    { echo "$key"; availability; } > "$STATE/avail.$$" && mv -f "$STATE/avail.$$" "$STATE/avail"
}

plan_state() {
    [ -d "$STATE" ] || mkdir -p "$STATE"
    cached_availability
    head=
    if [ "$1" = state ]; then
        v=
        [ -f "$MANIFEST" ] && read -r v < "$MANIFEST"
        v=${v:-# Flipfull (not installed)}
        hook=no
        hook_file >/dev/null && hook=yes
        google=-
        [ -f "$GOOGLE_CLIENT" ] && google=$(google_client_id)
        setting=no
        lock_held "$SET_LOCK" && setting=yes
        waiting=no
        [ -n "$(apps_todo "$APPS_WAITING")" ] && waiting=yes
        head="version ${v#"# "}|hook $hook|google-client $google|release-repo $RELEASE_REPO|setting $setting"
        head="$head|apps-waiting $waiting"
    fi
    awk -f "$PLAN_AWK" -v mode="$1" -v choices="$CHOICES" -v services="$SERVICES_INI" -v boot="$BOOT_PLAN" \
        -v avail="$STATE/avail" -v head="$head" "$REGISTRY"
}

cmd_state() { plan_state state; }

lock_held() {
    pid= boot= now=
    read -r pid boot 2>/dev/null < "$1/pid"
    read -r now < /proc/sys/kernel/random/boot_id
    [ -n "$pid" ] && [ "$boot" = "$now" ] && kill -0 "$pid" 2>/dev/null
}

take_lock() {
    mkdir "$1" 2>/dev/null ||
        { [ -f "$1/pid" ] && ! lock_held "$1" && rm -rf "$1" && mkdir "$1" 2>/dev/null; } || return 1
    read -r now < /proc/sys/kernel/random/boot_id
    echo "$$ $now" > "$1/pid"
}

set_lock() {
    until take_lock "$SET_LOCK"; do
        sleep 0.2
    done
    trap 'rm -rf "$SET_LOCK"' EXIT
}

cmd_set() {
    [ $# -gt 0 ] && [ $(($# % 2)) -eq 0 ] || die "usage: flipfull set ID on|off ..."
    changes=""
    while [ $# -gt 0 ]; do
        changes="$changes $1=$2"
        shift 2
    done
    [ -d "$STATE" ] || mkdir -p "$STATE"
    set_lock
    out=$(awk -f "$PLAN_AWK" -v mode=choose -v choices="$CHOICES" -v changes="$changes" "$REGISTRY") ||
        die "${out#error }"
    before=$(plan)
    [ -d "$CONFIG" ] || mkdir -p "$CONFIG"
    echo "$out" | awk -v to="$CHOICES.tmp" '
        BEGIN { printf "" > to }
        $1 == "choice" { print $2 "=" $3 > to }
        $1 == "also" { print "also " $2 " " $3 }' && mv -f "$CHOICES.tmp" "$CHOICES"
    after=$(plan)
    publish "$after" || echo "error: couldn't write features.js in $(http_root)"
    diff=$(printf '%s\n%s\n' "$before" "$after" | sort | uniq -u)
    # only the need kinds whose lines changed have something to do
    RESTARTED=
    for f in "$USERINIT"/needs/*.sh; do
        f=${f##*/}
        f=${f%.sh}
        has_line "$diff" "$f *" && "${f}_apply" set "$after"
    done
    has_line "$diff" 'feature ostore *' && reconcile_store "$after"
    restart_changed "$diff"
    plan_state state
}

# the apps whose need says restart, for the features that changed
restart_changed() {
    has_line "$1" 'feature *' || return 0
    cached_availability
    # the phone's awk takes no newlines in -v
    for app in $(PLAN_DIFF=$1 awk -f "$PLAN_AWK" -v mode=restarts -v avail="$STATE/avail" \
                     -v services="$SERVICES_INI" "$REGISTRY"); do
        has_word "$RESTARTED" "$app" && continue
        if sh "$USERINIT/tools/restart.sh" "$app" >/dev/null; then
            echo "restarted $app"
        fi
    done
}

ui_restart() {
    now=$(plan)
    echo "restarting the phone's UI"
    stop b2g
    svc_wait b2g stopped
    api_daemon_restart ui_apply "$now"
    start b2g
    svc_wait b2g running
    # init ignores a start while b2g is still stopping, which leaves the screen black
    if [ "$(getprop init.svc.b2g)" != running ]; then
        echo "b2g didn't start, starting it again"
        svc_wait b2g stopped
        start b2g
        svc_wait b2g running
    fi
    needs_apply boot-completed "$now"
    rm -f "$STATE/avail"
    cached_availability
    apps_finish
    echo "the phone's UI restarted"
}

ui_apply() {
    removable_boot
    echo "$1" > "$BOOT_PLAN"
    publish "$1" || echo "error: couldn't write features.js in $(http_root)"
    needs_apply ui "$1"
}

cmd_restart() {
    [ $# -eq 0 ] || exec sh "$USERINIT/tools/restart.sh" "$@"
    echo "==== $(date) : the phone's UI restarts ====" >> "$USERINIT/run.log"
    ui_restart 2>&1 | tee -a "$USERINIT/run.log"
}

app_info() {
    core= system=0
    case $1 in
        engmode|mmitest|logmanager|tctfota|antitheft|download) system=1 ;;
        sms) system=1 core="text messages" ;;
        bluetooth) system=1 core="Bluetooth pairing" ;;
        system) system=1 core="the whole phone UI" ;;
        shared) system=1 core="code every app uses" ;;
        launcher) system=1 core="home screen" ;;
        keyboard) system=1 core="typing" ;;
        settings) system=1 core="Settings" ;;
        callscreen) system=1 core="phone calls" ;;
        emergency-call) system=1 core="emergency calls" ;;
        network-alerts) system=1 core="emergency alerts" ;;
        ftu) system=1 core="first-run setup" ;;
        customization) system=1 core="carrier setup" ;;
        loginpages) system=1 core="account sign-in" ;;
        stk) system=1 core="SIM menus" ;;
        wappush) system=1 core="carrier messages" ;;
        wallpaper) system=1 core="wallpaper picker" ;;
        ringtones) system=1 core="ringtone picker" ;;
    esac
}

preloaded() {
    awk -F '"' '
        $2 == "name" { name = $4 }
        $2 == "manifest_url" { url = $4 }
        /}/ { if (name != "") print name, url; name = url = "" }' "$SYSTEM_WEBAPPS/webapps.json"
}

preloaded_url() { echo "$1" | awk -v name="$2" '$1 == name { print $2 }'; }

installed_apps() { "$SQLITE" -init /dev/null "$APPS_DB" 'SELECT manifest_url, removable FROM apps'; }

removable_boot() {
    [ -f "$APPS_DB" ] && [ -x "$SQLITE" ] || return 0
    in=
    if [ "$1" != reset ]; then
        for name in $(preloaded | awk '{ print $1 }'); do
            app_info "$name"
            [ $system = 1 ] || in="$in,'$name'"
        done
    fi
    "$SQLITE" -init /dev/null "$APPS_DB" \
        "UPDATE apps SET removable = CASE WHEN name IN (${in#,}) THEN 1 ELSE 0 END WHERE preloaded = 1"
    [ "$1" = reset ] || apps_start
}

app_title() {
    { app_manifest "$1" || cat "$SYSTEM_WEBAPPS/$1/manifest.webmanifest" ||
        unzip -p "$SYSTEM_WEBAPPS/$1/application.zip" manifest.webmanifest; } 2>/dev/null | json_value name
}

app_titles() {
    known=$(cat "$STATE/app-titles" 2>/dev/null)
    echo "$1" | while read -r name url; do
        has_line "$known" "$name$T*" || echo "$name$T$(app_title "$name")"
    done >> "$STATE/app-titles"
}

apps_todo() {
    [ -s "$1" ] || return 0
    apps=$(preloaded)
    have=$(installed_apps) || return 1
    for change in $(awk '{ w[$2] = $1 } END { for (n in w) print w[n] ":" n }' "$1"); do
        name=${change#*:}
        url=$(preloaded_url "$apps" "$name")
        case ${change%%:*} in
            uninstall) has_line "$have" "$url|*" && echo "uninstall $name" ;;
            install) has_line "$have" "$url|*" || echo "install $name" ;;
        esac
    done
}

removable_list() {
    T=$(printf '\t')
    mkdir -p "$STATE"
    apps=$(preloaded)
    [ -n "$apps" ] || die "couldn't read the apps from $SYSTEM_WEBAPPS/webapps.json"
    have=$(installed_apps) || die "couldn't read the apps from $APPS_DB"
    app_titles "$apps"
    titles="
$(cat "$STATE/app-titles")"
    todo="
$(apps_todo "$APPS_APPLYING"; apps_todo "$APPS_WAITING")"
    echo "$apps" | while read -r name url; do
        installed=0 removable=0
        has_line "$have" "$url|*" && installed=1
        has_line "$have" "$url|1" && removable=1
        pending=-
        has_line "$todo" "install $name" && pending=install
        has_line "$todo" "uninstall $name" && pending=uninstall
        title=${titles#*"
$name$T"}
        title=${title%%"
"*}
        app_info "$name"
        echo "app$T$name$T$installed$T$removable$T$pending$T$title$T$system$T$core"
    done
}

cmd_removable() {
    [ -x "$SQLITE" ] || die "$SQLITE is missing"
    case $1 in
        '') ;;
        install|uninstall)
            what=$1
            shift
            [ $# -gt 0 ] || die "usage: flipfull removable install|uninstall NAME..."
            apps=$(preloaded)
            for name; do
                has_line "$apps" "$name *" || die "$name isn't an app the phone came with"
            done
            have=$(installed_apps) || die "couldn't read the apps from $APPS_DB"
            mkdir -p "$STATE"
            for name; do
                echo "$what $name" >> "$APPS_WAITING"
                # one of the Apps uninstalls at once; the rest waits for the UI to restart
                url=$(preloaded_url "$apps" "$name")
                if [ $what = uninstall ] && has_line "$have" "$url|1"; then
                    app_uninstall "$url" "$name"
                fi
            done ;;
        *)
            die "usage: flipfull removable [install|uninstall NAME...]" ;;
    esac
    removable_list
}

apps_start() {
    todo=$(apps_todo "$APPS_WAITING") || return 0
    rm -f "$APPS_WAITING"
    [ -n "$todo" ] || return 0
    echo "$todo" > "$APPS_APPLYING"
    drop=$(echo "$todo" | awk '$1 == "uninstall" { printf " %s", $2 }')
    add=$(echo "$todo" | awk '$1 == "install" { printf " %s", $2 }')
    log "apps: uninstalling${drop:- none}, installing${add:- none}"
    apps_prepare "$drop" "$add"
}

apps_finish() {
    [ -f "$APPS_APPLYING" ] || return 0
    apps=$(preloaded)
    drop=$(awk '$1 == "uninstall" { printf " %s", $2 }' "$APPS_APPLYING")
    add=$(awk '$1 == "install" { printf " %s", $2 }' "$APPS_APPLYING")
    if [ -n "$add" ]; then
        apps_added "$add"
        umount "$SYSTEM_WEBAPPS/webapps.json"
    fi
    if [ -n "$drop" ]; then
        # Gecko forgets an uninstalled app's permissions and data only while b2g is connected
        ui_up
        for name in $drop; do
            app_uninstall "$(preloaded_url "$apps" "$name")" "$name"
        done
    fi
    rm -f "$APPS_APPLYING"
}

ui_up() {
    _i=0
    until grep -qx launcher /proc/[0-9]*/comm 2>/dev/null || [ $_i -ge 150 ]; do
        sleep 0.2
        _i=$((_i + 1))
    done
    sleep 1
}

apps_prepare() {
    if [ -n "$1" ]; then
        in=$(echo $1 | sed "s/[^ ]*/'&'/g; s/ /,/g")
        "$SQLITE" -init /dev/null "$APPS_DB" "UPDATE apps SET removable = 1 WHERE name IN ($in)"
    fi
    [ -n "$2" ] || return 0
    apps_loose=
    for name in $2; do
        app_info "$name"
        [ $system = 1 ] || apps_loose="$apps_loose $name"
    done

    awk -v want=" $2 " -v loose=" $apps_loose " '
        BEGIN { print "[" }
        /{/ { inside = 1; head = $0; block = ""; name = ""; next }
        inside && !/"removable"/ {
            line = $0
            sub(/},?[ \t]*$/, "}", line)
            block = block "\n" line
            split($0, f, "\"")
            if (f[2] == "name") name = f[4]
        }
        inside && /}/ {
            inside = 0
            if (index(loose, " " name " ")) head = head "\n    \"removable\": true,"
            if (index(want, " " name " ")) printf "%s%s%s", (n++ ? ",\n" : ""), head, block
        }
        END { print "\n]" }' "$SYSTEM_WEBAPPS/webapps.json" > "$STATE/webapps.json"
    label_system_file "$STATE/webapps.json"
    mount -o bind "$STATE/webapps.json" "$SYSTEM_WEBAPPS/webapps.json" ||
        { echo "error: couldn't mount the list of apps to put back"; return 1; }
    fingerprint '"flipfull"'
}

fingerprint() {
    "$SQLITE" -init /dev/null "$API_DAEMON/settings.sqlite" \
        "UPDATE settings SET value = '$1' WHERE name = 'system.saved.fingerprint'"
}

apps_added() {
    _i=0
    while [ $_i -lt 150 ]; do
        have=$(installed_apps)
        missing=
        for name in $1; do
            has_line "$have" "$(preloaded_url "$apps" "$name")|*" || missing="$missing $name"
        done
        [ -n "$missing" ] || { echo "installed$1"; return 0; }
        sleep 0.2
        _i=$((_i + 1))
    done
    echo "error:$missing didn't install"
    fingerprint "\"$(getprop ro.system.build.fingerprint)\""
    return 1
}

google_client_id() {
    id=
    [ -f "$GOOGLE_CLIENT" ] && id=$(json_value client_id < "$GOOGLE_CLIENT")
    echo "${id:--}"
}

check_google_client() {
    grep -q '"web"' "$1" || die "$1 isn't a Web application client; create one of that type in Google Cloud"
    grep -qF "$GOOGLE_REDIRECT" "$1" ||
        die "add $GOOGLE_REDIRECT under Authorized redirect URIs in Google Cloud, then download the JSON again"
    [ -n "$(json_value client_id < "$1")" ] && [ -n "$(json_value client_secret < "$1")" ] ||
        die "$1 has no client_id or client_secret"
}

cmd_google_client() {
    case $1 in
        '')
            google_client_id ;;
        import)
            src=$2
            if [ -z "$src" ]; then
                found=$(find /data/media /mnt/sdcard/ /storage/ -maxdepth 4 -name 'client_secret*.json' 2>/dev/null)
                [ -n "$found" ] && src=$(ls -t $found | head -1)
            fi
            [ -n "$src" ] || die "no client_secret*.json on the phone: copy the file from Google Cloud to its storage"
            check_google_client "$src"
            mkdir -p "$CONFIG"
            cp "$src" "$GOOGLE_CLIENT.tmp" && chmod 0600 "$GOOGLE_CLIENT.tmp" &&
                mv -f "$GOOGLE_CLIENT.tmp" "$GOOGLE_CLIENT" || die "couldn't save it in $CONFIG"
            echo "Google sign-in client $(google_client_id) from $src" ;;
        remove)
            rm -f "$GOOGLE_CLIENT"
            echo "Google sign-in client removed" ;;
        *)
            die "usage: flipfull google-client [import [FILE] | remove]" ;;
    esac
}

version() {
    v=
    [ -f "$MANIFEST" ] && read -r v < "$MANIFEST"
    v=${v:-# Flipfull (not installed)}
    echo "${v#"# "}"
}

hook_file() {
    grep -ls "$USERINIT/run.sh" /system/etc/init/*.rc /vendor/etc/init/*.rc /odm/etc/init/*.rc \
        /product/etc/init/*.rc /system_ext/etc/init/*.rc | { read -r f && echo "$f"; }
}

sync_from() {
    src=$1
    [ -f "$src/.files" ] || die "$src/.files is missing"
    mkdir -p "$STATE" "$CONFIG" || die "can't write $USERINIT"
    rm -f "$USERINIT/uninstall"
    : > "$STATE/changed"
    grep -v '^#' "$src/.files" > "$STATE/.files.new"
    [ -s "$STATE/.files.new" ] || die "$src/.files lists no files"
    while read -r f; do
        [ -z "$f" ] || [ -f "$src/$f" ] || [ -f "$USERINIT/$f" ] ||
            die "$f is missing from $src; install this version from a computer (install.sh / install.bat)"
    done < "$STATE/.files.new"
    while read -r f; do
        [ -n "$f" ] || continue
        if [ -f "$src/$f" ]; then
            cmp -s "$src/$f" "$USERINIT/$f" && continue
            mkdir -p "$(dirname "$USERINIT/$f")" && mv -f "$src/$f" "$USERINIT/$f" || die "couldn't update $f"
            echo "$f" >> "$STATE/changed"
        fi
    done < "$STATE/.files.new"
    grep -v '^#' "$MANIFEST" 2>/dev/null | grep -vxF -f "$STATE/.files.new" | while read -r f; do
        [ -n "$f" ] || continue
        rm -f "$USERINIT/$f" && echo "removed $f (no longer in Flipfull)"
        (cd "$USERINIT" && rmdir -p "$(dirname "$f")" 2>/dev/null)
    done
    rm -f "$STATE/.files.new"
    cp "$src/.files" "$MANIFEST"
    echo "$(wc -l < "$STATE/changed") of $(grep -vc '^#' "$src/.files") files changed"
}

cmd_setup() {
    if [ "$1" = --from ]; then
        [ -n "$2" ] || die "usage: flipfull setup [--from DIR]"
        sync_from "$(cd "$2" && pwd)"
        exec sh "$USERINIT/flipfull" setup
    fi
    [ -f "$REGISTRY" ] || die "$USERINIT isn't installed"
    mkdir -p "$CONFIG" "$STATE"

    chown -R root:root "$USERINIT"
    find "$USERINIT" -type d -exec chmod 0711 {} \;
    find "$USERINIT" -type f -exec chmod 0644 {} \;
    find "$USERINIT" -type f \( -name '*.sh' -o -path '*/bin/*' -o -path '*/remote/*/daemon' -o -name toolboxd \
         -o -name flipfull \) -exec chmod 0755 {} \;
    [ -f "$GOOGLE_CLIENT" ] && chmod 0600 "$GOOGLE_CLIENT"

    publish || echo "error: couldn't write features.js in $(http_root)"

    now=$(plan)
    needs_apply setup "$now" "$(cat "$STATE/changed" 2>/dev/null)"
    reconcile_store "$now"
    cmd_removable >/dev/null 2>&1

    hook_file >/dev/null ||
        echo "WARNING: no boot hook runs $USERINIT/run.sh - nothing here starts at boot (src/boot-hook/README.md)"
    version
    # the first install applies the default features without a reboot
    if [ ! -f "$BOOT_PLAN" ]; then
        echo "The phone's UI restarts now, about 15 seconds"
        cmd_restart
        return
    fi
    cmd_state | awk -F '\t' '$1 == "ui" && $2 == "yes" {
        print "Some features wait for the phone\047s UI to restart: Flipfull > Options > Restart the phone\047s UI" }'
}

cmd_uninstall() {
    touch "$USERINIT/uninstall"
    needs_apply set ""
    reconcile_store ""
    list=$(apps_cmd list)
    echo "Everything else is removed at the next boot; the phone then boots stock (preloaded apps you"
    echo "uninstalled stay uninstalled). Changed your mind before rebooting? Install again."
    url=$(app_url flipfull)
    if [ "$1" = --reboot ]; then
        setsid sh -c "sleep 1; echo '{\"cmd\":\"uninstall\",\"param\":\"$url\"}' | nc -U -W 60 $APPS_SOCK;
                      sh $USERINIT/services/toolbox/service.sh stop; sync; reboot" </dev/null >/dev/null 2>&1 &
    else
        case $list in *"$url"*) apps_cmd uninstall "$url" >/dev/null && echo "uninstalled the Flipfull app" ;; esac
        sh "$USERINIT/services/toolbox/service.sh" stop
    fi
}

update_step() { echo "running $$ $*" > "$STATE/update"; }

update_failed() {
    echo "error: $*"
    echo "failed $*" > "$STATE/update"
    rm -rf "$UPDATE_DIR"
    exit 1
}

cmd_update() {
    case $1 in
        ''|status)
            read -r word rest 2>/dev/null < "$STATE/update" || word=none
            if [ "$word" = running ] && ! kill -0 "${rest%% *}" 2>/dev/null; then
                word=failed
                rest="the update stopped before it finished (did the phone restart?)"
            elif [ "$word" = running ]; then
                rest=${rest#* }
            fi
            printf 'update\t%s\t%s\n' "$word" "$rest"
            [ -f "$UPDATE_DIR/update.zip" ] && printf 'bytes\t%s\n' "$(stat -c %s "$UPDATE_DIR/update.zip")"
            tail -n 12 "$STATE/update.log" 2>/dev/null | awk '{ print "log\t" $0 }' ;;
        start)
            [ $# -eq 4 ] || die "usage: flipfull update start TAG ASSET SHA256"
            case $2 in ''|*[!A-Za-z0-9._-]*) die "not a release tag: $2" ;; esac
            case $3 in flipfull-*-update.zip) ;; *) die "not a Flipfull update: $3" ;; esac
            case $3 in *[!A-Za-z0-9._-]*) die "not a Flipfull update: $3" ;; esac
            echo "$4" | grep -qx '[0-9a-f]\{64\}' || die "not a sha256: $4"
            read -r word pid rest 2>/dev/null < "$STATE/update"
            [ "$word" = running ] && kill -0 "$pid" 2>/dev/null && die "an update is already running"
            mkdir -p "$STATE"
            rm -f "$STATE/update"
            : > "$STATE/update.log"
            setsid sh "$USERINIT/flipfull" update-run "$2" "$3" "$4" </dev/null >>"$STATE/update.log" 2>&1 &
            echo "started" ;;
        *)
            die "usage: flipfull update [status] | update start TAG ASSET SHA256" ;;
    esac
}

update_run() {
    update_step "Downloading"
    url=https://github.com/$RELEASE_REPO/releases/download/$1/$2
    echo "downloading $url"
    rm -rf "$UPDATE_DIR" && mkdir -p "$UPDATE_DIR" || update_failed "can't write $UPDATE_DIR"
    curl -fsSL --retry 2 --connect-timeout 20 -o "$UPDATE_DIR/update.zip" "$url" ||
        update_failed "couldn't download $2"
    [ "$(sha256sum "$UPDATE_DIR/update.zip" | cut -d' ' -f1)" = "$3" ] ||
        update_failed "the download doesn't match its checksum"
    update_step "Unpacking"
    unzip -q "$UPDATE_DIR/update.zip" -d "$UPDATE_DIR/files" || update_failed "couldn't unpack $2"
    rm -f "$UPDATE_DIR/update.zip"
    src=$(ls -d "$UPDATE_DIR"/files/*/flipfull 2>/dev/null | head -1)
    [ -f "$src/flipfull" ] && [ -f "$src/.files" ] || update_failed "$2 isn't a Flipfull update"
    update_step "Installing"
    sh "$src/flipfull" setup --from "$src" || update_failed "setup failed; see the log"
    rm -rf "$UPDATE_DIR"
    echo "done $(version)" > "$STATE/update"
}

cmd_status() {
    version
    f=$(hook_file) && echo "boot hook: $f" ||
        echo "boot hook: MISSING - nothing here runs at boot (src/boot-hook/README.md)"
    [ -e "$USERINIT/uninstall" ] && echo "uninstall pending: the next boot removes everything"
    echo
    id=$(google_client_id)
    echo "Google sign-in client: $([ "$id" = - ] && echo none || echo "$id")"
    echo
    echo "features:"
    plan_state list
    echo
    echo "mounted:"
    awk '$4 ~ /userinit\/(overlays|media|state|etc)/ { print "  " $5 "  <-  " $4 }' /proc/self/mountinfo
    echo
    echo "services:"
    for s in "$USERINIT"/services/*/service.sh; do
        sh "$s" status
    done
    echo
    echo "updaters (block-updates stops update_engine after boot.):"
    for s in update_engine updater-daemon; do
        echo "  $s: $(getprop init.svc.$s)"
    done
    echo
    echo "last boot:"
    tail -15 "$USERINIT/run.log" 2>/dev/null
}

cmd=$1
[ $# -gt 0 ] && shift
case $cmd in
    set|setup|store|uninstall|removable) . "$HERE/lib/store.sh" ;;
esac
case $cmd in
    features) cat "$REGISTRY" ;;
    state) cmd_state ;;
    list) plan_state list ;;
    set) cmd_set "$@" ;;
    plan) plan ;;
    removable) cmd_removable "$@" ;;
    removable-boot) removable_boot "$@" ;;
    removable-finish) apps_finish ;;
    google-client) cmd_google_client "$@" ;;
    status) cmd_status ;;
    log) tail -n "${1:-200}" "$USERINIT/run.log" ;;
    restart) cmd_restart "$@" ;;
    reboot)
        echo "rebooting"
        setsid sh -c 'sleep 1; sync; reboot' </dev/null >/dev/null 2>&1 & ;;
    install-app)
        [ -f "$1" ] || die "usage: flipfull install-app ZIP"
        install_zip "$1" "$(basename "$1" .zip)" ;;
    setup) cmd_setup "$@" ;;
    update) cmd_update "$@" ;;
    update-run) update_run "$@" ;;
    store) cmd_store "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *) usage; exit 2 ;;
esac
