#!/system/bin/sh

usage() {
    cat <<'EOF'
flipfull - turns Flipfull's features on and off, and installs, updates and
removes Flipfull.

  flipfull features               the feature list (features.ini)
  flipfull state                  each feature: on / off, at the last boot, usable on this phone; what waits for a reboot
  flipfull set ID on|off ...      turn features on / off
  flipfull plan                   what the features that are on need
  flipfull publish [--remove]     write (or delete) features.js for the overlays
  flipfull removable [set NAME...]    preloaded apps that can be uninstalled
  flipfull google-client [import [FILE] | remove]
                                  your own Google sign-in client
  flipfull status                 a summary to read (flip4.py status)
  flipfull log [LINES]            the boot log
  flipfull restart [APP...]       restart the UI, or only those apps
  flipfull reboot
  flipfull install-app ZIP        install an application.zip through api-daemon
  flipfull setup [--from DIR]     install or update from DIR, a copy of
                                  userinit/ with .files listing it
  flipfull update start TAG ASSET SHA256
                                  download that release asset from
                                  RELEASE_REPO, check it and install it, in
                                  the background
  flipfull update [status]        how the last update went
  flipfull store info | get URL | stage URL [SHA256] | install ORIGIN SOURCE
               | uninstall NAME | installed
                                  what the Flipstore app asks for (flipstore
                                  feature)
  flipfull uninstall [--reboot]   remove Flipfull; the next boot finishes it
EOF
}

HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib/common.sh"

REGISTRY=$USERINIT/features.ini
PLAN_AWK=$USERINIT/lib/plan.awk
CONFIG=$USERINIT/config
STATE=$USERINIT/state
CHOICES=$CONFIG/features
REMOVABLE=$CONFIG/removable-apps
GOOGLE_CLIENT=$CONFIG/google-client.json
MANIFEST=$USERINIT/.installed-files
VROOT=/data/local/webapps/vroot
APPS_SOCK=/data/local/tmp/apps-uds.sock
APPS_DB=/data/local/webapps/db/apps.sqlite
SQLITE=$USERINIT/bin/sqlite3
API_DAEMON_CONFIG=/data/local/service/api-daemon/config.toml
GOOGLE_REDIRECT=http://localhost/redirect/loginpages/redirect.html
DICTATE=http://dictate.localhost/manifest.webmanifest

RELEASE_REPO=Smoked-Fish/Flipfull
STORE_REPO=Smoked-Fish/Flipstore
UPDATE_DIR=/data/local/tmp/flipfull-update
STORE_ORIGIN=flipstore
STORE_DIR=/data/local/tmp/flipstore
STORE_MAX=52428800

die() {
    echo "error: $*" >&2
    exit 1
}

plan() { awk -f "$PLAN_AWK" -v choices="$CHOICES" "$REGISTRY"; }

needs() { awk -f "$PLAN_AWK" -v mode=needs "$REGISTRY"; }

http_root() {
    r=$(sed -n '/^\[http\]/,/^\[/s/^root_path *= *"\(.*\)"/\1/p' "$API_DAEMON_CONFIG" 2>/dev/null)
    echo "${r:-/data/local/service/api-daemon/http_root}"
}

publish() {
    dir=$(http_root)/flipfull
    mkdir -p "$dir" || return 1
    { if [ -n "$1" ]; then echo "$1"; else plan; fi; } | awk -v src="$USERINIT/flipfull" '
        BEGIN {
            print "// Written by " src ": the Flipfull features that are on."
            printf "window.FlipfullFeatures = {"
        }
        $1 == "feature" && $3 == "on" { printf "%s\"%s\": true", n++ ? ", " : "", $2 }
        END { print "};" }' > "$dir/features.js.tmp" &&
        chmod 0644 "$dir/features.js.tmp" && mv -f "$dir/features.js.tmp" "$dir/features.js"
}

overlay_status() {
    src=$USERINIT/overlays/$1
    if [ ! -f "$src/application.zip" ]; then
        echo "not on the phone"
        return
    fi
    if [ -n "$PRELOADED" ] && ! echo "$PRELOADED" | grep -qx "$1"; then
        echo ok
        return
    fi
    dst=$(readlink -f "$VROOT/$1" 2>/dev/null)
    if [ -z "$dst" ] || [ ! -d "$dst" ]; then
        echo "the phone has no $1 app"
    elif same_dir "$src" "$dst" || stock_matches "$src" "$dst/application.zip"; then
        echo ok
    else
        echo "made for another version of the phone's $1 app"
    fi
}

availability() {
    PRELOADED=$(preloaded_apps)
    needs | awk '{ print $2, $3 }' | sort -u | while read -r kind name; do
        case $kind in
            overlay) echo "overlay $name $(overlay_status "$name")" ;;
            app) [ -f "$USERINIT/apps/$name/application.zip" ] && echo "app $name ok" ||
                     echo "app $name not on the phone" ;;
            service) [ -f "$USERINIT/services/$name/service.sh" ] && echo "service $name ok" ||
                         echo "service $name not on the phone" ;;
        esac
    done
}

cached_availability() {
    key="# $(cat /proc/sys/kernel/random/boot_id) $(stat -c %Y "$MANIFEST" "$APPS_DB" "$APPS_DB-wal" 2>/dev/null | tr '\n' ' ')"
    [ "$(head -1 "$STATE/avail" 2>/dev/null)" = "$key" ] && return 0
    { echo "$key"; availability; } > "$STATE/avail.tmp" && mv -f "$STATE/avail.tmp" "$STATE/avail"
}

cmd_state() {
    mkdir -p "$STATE"
    cached_availability
    pending=0
    removable_pending && pending=1
    printf 'version\t%s\n' "$(version)"
    printf 'hook\t%s\n' "$(hook_file >/dev/null && echo yes || echo no)"
    printf 'removable\t%s\n' "$([ $pending = 1 ] && echo pending || echo saved)"
    printf 'google-client\t%s\n' "$(google_client_id)"
    printf 'release-repo\t%s\n' "$RELEASE_REPO"
    awk -f "$PLAN_AWK" -v mode=state -v choices="$CHOICES" -v boot="$BOOT_PLAN" \
        -v avail="$STATE/avail" -v pending=$pending "$REGISTRY"
}

cmd_set() {
    [ $# -gt 0 ] && [ $(($# % 2)) -eq 0 ] || die "usage: flipfull set ID on|off ..."
    changes=""
    while [ $# -gt 0 ]; do
        changes="$changes $1=$2"
        shift 2
    done
    out=$(awk -f "$PLAN_AWK" -v mode=choose -v choices="$CHOICES" -v changes="$changes" "$REGISTRY") ||
        die "${out#error }"
    before=$(plan)
    mkdir -p "$CONFIG"
    echo "$out" | awk '$1 == "choice" { print $2 "=" $3 }' > "$CHOICES.tmp" && mv -f "$CHOICES.tmp" "$CHOICES"
    echo "$out" | awk '$1 == "also" { print "also " $2 " " $3 }'
    after=$(plan)
    publish "$after" || echo "error: couldn't write features.js in $(http_root)"
    changed=$(printf '%s\n%s\n' "$before" "$after" | sort | uniq -u)
    if echo "$changed" | grep -q '^service '; then
        reconcile_services "$after"
    fi
    if apps_changed "$changed"; then
        reconcile_apps "$after"
    fi
    if echo "$changed" | grep -q '^feature flipstore '; then
        reconcile_store "$after"
    fi
    restart_changed "$before" "$after"
}

apps_changed() {
    echo "$1" | grep -q '^app ' && return 0
    overlays=$(echo "$1" | awk '$1 == "overlay" { print $2 }')
    [ -n "$overlays" ] || return 1
    pre=$(preloaded_apps)
    [ -z "$pre" ] || echo "$overlays" | grep -qvxF "$pre"
}

restart_changed() {
    changed=$(printf '%s\n%s\n' "$1" "$2" | awk '$1 == "feature"' | sort | uniq -u | awk '{ print $2 }' | sort -u)
    [ -n "$changed" ] || return 0
    apps=$(needs | awk -v ids=" $(echo $changed) " '
        $2 == "overlay" && ($3 == "launcher" || $3 == "settings") && index(ids, " " $1 " ") { print $3 }' | sort -u)
    for app in $apps; do
        same_dir "$USERINIT/overlays/$app" "$(readlink -f "$VROOT/$app")" || continue
        if sh "$USERINIT/tools/restart.sh" "$app" >/dev/null; then
            echo "restarted $app"
        fi
    done
}

running() { sh "$USERINIT/services/$1/service.sh" status >/dev/null 2>&1; }

reconcile_services() {
    wanted_plan=$1
    shift
    for s in "$USERINIT"/services/*/service.sh; do
        [ -f "$s" ] || continue
        d=${s%/service.sh}
        name=${d##*/}
        want=0
        if [ "$name" = toolbox ] || echo "$wanted_plan" | grep -qx "service $name"; then
            want=1
        fi
        [ -e "$d/disabled" ] && want=0
        if running "$name"; then
            if [ $want = 0 ]; then
                sh "$s" stop >/dev/null 2>&1
                echo "stopped $name"
            elif echo " $* " | grep -q " $name "; then
                sh "$s" restart >/dev/null 2>&1 && echo "restarted $name" || echo "error: $name didn't start again"
            fi
        elif [ $want = 1 ]; then
            sh "$s" start >/dev/null 2>&1 && echo "started $name" || echo "error: $name didn't start (services/$name)"
        fi
    done
}

apps_cmd() {
    if [ $# -gt 1 ]; then
        echo "{\"cmd\":\"$1\",\"param\":\"$2\"}"
    else
        echo "{\"cmd\":\"$1\"}"
    fi | nc -U -W 120 "$APPS_SOCK" 2>&1
}

apps_ok() { case $1 in *'"success"'*) return 0 ;; esac; return 1; }

json_value() {
    tr -d '\n' | grep -o "\"$1\" *: *\"[^\"]*\"" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}

app_url() {
    m=$USERINIT/apps/$1/manifest.webmanifest
    [ -f "$m" ] || return 1
    origin=$(json_value origin < "$m")
    [ -n "$origin" ] && echo "http://$origin.localhost/manifest.webmanifest"
}

install_zip() {
    tmp=/data/local/tmp/flipfull-$2.zip
    cp "$1" "$tmp" && chmod 0644 "$tmp" || return 1
    r=$(apps_cmd install "$tmp")
    rm -f "$tmp"
    if apps_ok "$r"; then
        echo "installed $2"
    else
        echo "error: $2 didn't install: $r"
        return 1
    fi
}

app_install() {
    url=$(app_url "$1")
    if [ "$1" = kaiva ]; then
        list=$(apps_cmd list)
        case $list in *"$DICTATE"*)
            apps_ok "$(apps_cmd uninstall "$DICTATE")" && echo "uninstalled Dictate; KaiVA replaces it"
            case $list in *"$url"*) apps_cmd uninstall "$url" >/dev/null ;; esac ;;
        esac
    fi
    install_zip "$USERINIT/apps/$1/application.zip" "$1"
}

installed_names() { echo "$1" | tr -d '\\' | grep -o '"name":"[^"]*"' | cut -d'"' -f4; }

reconcile_apps() {
    wanted_plan=$1
    shift
    list=$(apps_cmd list)
    apps_ok "$list" || {
        echo "error: api-daemon's app list isn't available: $list"
        return 1
    }
    for d in "$USERINIT"/apps/*/; do
        name=$(basename "$d")
        url=$(app_url "$name") || continue
        installed=0
        case $list in *"$url"*) installed=1 ;; esac
        want=0
        if [ "$name" = flipfull ] || echo "$wanted_plan" | grep -qx "app $name"; then
            want=1
        fi
        if [ $want = 1 ] && { [ $installed = 0 ] || echo " $* " | grep -q " $name "; }; then
            app_install "$name"
        elif [ $want = 0 ] && [ $installed = 1 ]; then
            apps_ok "$(apps_cmd uninstall "$url")" && echo "uninstalled $name" || echo "error: $name didn't uninstall"
        fi
    done
    pre=$(preloaded_apps)
    [ -n "$pre" ] || return 0
    names=$(installed_names "$list")
    for app in $(echo "$wanted_plan" | awk '$1 == "overlay" { print $2 }'); do
        echo "$pre" | grep -qx "$app" && continue
        if ! echo "$names" | grep -qx "$app" || echo " $* " | grep -q " $app "; then
            install_zip "$USERINIT/overlays/$app/application.zip" "$app"
        fi
    done
}

app_info() {
    core= rank=3 about=
    case $1 in
        kaios-news) rank=1 about="KaiOS's news reader." ;;
        kaios-weather) rank=1 about="KaiOS's weather forecast app." ;;
        kaios-pay) rank=1 about="KaiOS's mobile payment wallet. It isn't in the app list." ;;
        kaios-todo) rank=1 about="A to-do list." ;;
        youtube) rank=1 about="Opens m.youtube.com in the browser; nothing else is installed." ;;
        googlesearch) rank=1 about="Opens Google Search in the browser. The browser itself (Internet in the app list) stays." ;;
        maps) rank=1 about="Google Maps, a web app. Flipfull's Google Maps navigation works in it." ;;
        kaios-2048|kaios-birdy|kaios-gems|kaios-guardians|kaios-whackamole|brickbreaker2018)
            rank=1 about="A game KaiOS preinstalls." ;;
        engmode) rank=2 about="Engineering mode: hidden radio and hardware test menus, opened with dialer codes." ;;
        mmitest) rank=2 about="The factory's hardware test (keys, screens, sound, camera), opened with a dialer code." ;;
        logmanager) rank=2 about="Saves logs for bug reports, opened with a dialer code." ;;
        tctfota) rank=2 about="TCL's system updater (Settings > Device > Software update). A system update removes root and Flipfull." ;;
        antitheft) rank=2 about="Kill-switch: rings the phone at full volume when KaiOS's anti-theft service tells it to." ;;
        download) rank=2 about="Lets other apps attach a file you downloaded." ;;
        kaios-store) about="KaiStore: installs and updates KaiOS apps, Music and Video included." ;;
        calculator) about="A calculator." ;;
        calendar) about="Calendar; syncs with Google and Exchange accounts." ;;
        camera) about="Photos and video. Two presses of the quick access button open it; other apps use it to attach a photo." ;;
        clock) about="Alarms, timer and stopwatch. Without it alarms don't ring." ;;
        communications) about="Your recent calls. Calling works without it: the dialer is part of the home screen." ;;
        contact) about="Your contacts. Messages, Call Log and the dialer pick numbers from it." ;;
        email) about="E-mail for Gmail, Outlook and other accounts." ;;
        filemanager) about="Browses the phone's storage and the SD card." ;;
        fm) about="FM radio; wired headphones are its antenna." ;;
        gallery) about="Your photos; other apps pick photos from it." ;;
        music) about="Music player and Icecast internet radio." ;;
        notes) about="Simple text notes." ;;
        soundrecorder) about="Voice recordings." ;;
        video) about="Video player, with YouTube picks." ;;
        sms) rank=4 core="text messages" about="Text and picture messages (SMS, MMS)." ;;
        bluetooth) rank=4 core="Bluetooth pairing" about="Bluetooth pairing requests and file transfers." ;;
        system) rank=4 core="the whole phone UI" about="The status bar, lock screen, notifications, outer screen and everything around the apps." ;;
        shared) rank=4 core="code every app uses" about="Fonts, sounds, wallpapers and code the other apps load." ;;
        launcher) rank=4 core="home screen" about="The home screen, the app list and the dialer." ;;
        keyboard) rank=4 core="typing" about="Typing in every text field." ;;
        settings) rank=4 core="Settings" about="Settings." ;;
        callscreen) rank=4 core="phone calls" about="The screen during a call." ;;
        emergency-call) rank=4 core="emergency calls" about="Emergency calls from the lock screen." ;;
        network-alerts) rank=4 core="emergency alerts" about="Wireless emergency alerts: AMBER, extreme weather, presidential." ;;
        ftu) rank=4 core="first-run setup" about="The setup the phone runs when it first starts, and after a reset." ;;
        customization) rank=4 core="carrier setup" about="Applies the carrier's settings for the SIM you put in." ;;
        loginpages) rank=4 core="account sign-in" about="The sign-in pages of Settings > Accounts." ;;
        stk) rank=4 core="SIM menus" about="SIM Toolkit: your SIM card's own menu and carrier services." ;;
        wappush) rank=4 core="carrier messages" about="Receives the carrier's WAP push and settings messages." ;;
        wallpaper) rank=4 core="wallpaper picker" about="The wallpaper picker in Settings." ;;
        ringtones) rank=4 core="ringtone picker" about="Picks ringtones and notification sounds." ;;
    esac
    printf '%s\t%s\t%s' "$core" "$rank" "$about"
}

preloaded() {
    "$SQLITE" -init /dev/null -separator ' ' "$APPS_DB" \
        'SELECT name, removable FROM apps WHERE preloaded = 1 ORDER BY name' 2>/dev/null
}

app_manifest() {
    m=$VROOT/$1/manifest.webmanifest
    if [ -f "$m" ]; then
        cat "$m"
    elif [ -f "$VROOT/$1/application.zip" ]; then
        unzip -p "$VROOT/$1/application.zip" manifest.webmanifest 2>/dev/null
    else
        cat "$VROOT/cached/$1/manifest.webmanifest" 2>/dev/null
    fi
}

app_title() { app_manifest "$1" | json_value name; }

removable_wanted() {
    if [ -f "$REMOVABLE" ]; then
        grep -qx "$1" "$REMOVABLE"
    else
        [ "$2" = 1 ]
    fi
}

removable_pending() {
    [ -f "$REMOVABLE" ] || return 1
    preloaded | awk -v list="$REMOVABLE" '
        BEGIN { while ((getline name < list) > 0) want[name] = 1 }
        ($1 in want) != ($2 == 1) { differs = 1; exit }
        END { exit !differs }'
}

cmd_removable() {
    [ -x "$SQLITE" ] || die "$SQLITE is missing"
    apps=$(preloaded)
    [ -n "$apps" ] || die "couldn't read the apps from $APPS_DB"
    if [ "$1" != set ]; then
        echo "$apps" | while read -r name flag; do
            removable_wanted "$name" "$flag" && want=1 || want=0
            printf 'app\t%s\t%s\t%s\t%s\t%s\n' "$name" "$flag" "$want" "$(app_title "$name")" "$(app_info "$name")"
        done
        return
    fi
    shift
    for name; do
        echo "$apps" | grep -q "^$name " || die "$name isn't a preloaded app"
    done
    mkdir -p "$CONFIG"
    for name; do echo "$name"; done | sort -u > "$REMOVABLE.tmp" && mv -f "$REMOVABLE.tmp" "$REMOVABLE"
    echo "saved $# removable apps; the next boot applies it"
}

google_client_id() {
    id=
    [ -f "$GOOGLE_CLIENT" ] && id=$(json_value client_id < "$GOOGLE_CLIENT")
    echo "${id:--}"
}

check_google_client() {
    grep -q '"web"' "$1" || die "$1 isn't a Web application client; create one of that type in Google Cloud"
    grep -qF "$GOOGLE_REDIRECT" "$1" ||
        die "add $GOOGLE_REDIRECT under Authorized redirect URIs in Google Cloud, then download the JSON again"
    [ -n "$(json_value client_id < "$1")" ] && [ -n "$(json_value client_secret < "$1")" ] ||
        die "$1 has no client_id or client_secret"
}

cmd_google_client() {
    case $1 in
        '')
            google_client_id ;;
        import)
            src=$2
            if [ -z "$src" ]; then
                found=$(find /data/media /mnt/sdcard/ /storage/ -maxdepth 4 -name 'client_secret*.json' 2>/dev/null)
                [ -n "$found" ] && src=$(ls -t $found | head -1)
            fi
            [ -n "$src" ] || die "no client_secret*.json on the phone: copy the file from Google Cloud to its storage"
            check_google_client "$src"
            mkdir -p "$CONFIG"
            cp "$src" "$GOOGLE_CLIENT.tmp" && chmod 0600 "$GOOGLE_CLIENT.tmp" &&
                mv -f "$GOOGLE_CLIENT.tmp" "$GOOGLE_CLIENT" || die "couldn't save it in $CONFIG"
            echo "Google sign-in client $(google_client_id) from $src" ;;
        remove)
            rm -f "$GOOGLE_CLIENT"
            echo "Google sign-in client removed" ;;
        *)
            die "usage: flipfull google-client [import [FILE] | remove]" ;;
    esac
}

version() {
    v=$(head -1 "$MANIFEST" 2>/dev/null)
    echo "${v:-# Flipfull (not installed)}" | sed 's/^# //'
}

hook_file() {
    for f in /system/etc/init/*.rc /vendor/etc/init/*.rc /odm/etc/init/*.rc \
             /product/etc/init/*.rc /system_ext/etc/init/*.rc; do
        grep -q "$USERINIT/run.sh" "$f" 2>/dev/null && { echo "$f"; return 0; }
    done
    return 1
}

sync_from() {
    src=$1
    [ -f "$src/.files" ] || die "$src/.files is missing"
    mkdir -p "$STATE" "$CONFIG" || die "can't write $USERINIT"
    rm -f "$USERINIT/uninstall"
    : > "$STATE/changed"
    grep -v '^#' "$src/.files" > "$STATE/.files.new"
    [ -s "$STATE/.files.new" ] || die "$src/.files lists no files"
    while read -r f; do
        [ -z "$f" ] || [ -f "$src/$f" ] || [ -f "$USERINIT/$f" ] ||
            die "$f is missing from $src; install this version from a computer (install.sh / install.bat)"
    done < "$STATE/.files.new"
    while read -r f; do
        [ -n "$f" ] || continue
        if [ -f "$src/$f" ]; then
            cmp -s "$src/$f" "$USERINIT/$f" && continue
            mkdir -p "$(dirname "$USERINIT/$f")" && mv -f "$src/$f" "$USERINIT/$f" || die "couldn't update $f"
            echo "$f" >> "$STATE/changed"
        fi
    done < "$STATE/.files.new"
    grep -v '^#' "$MANIFEST" 2>/dev/null | grep -vxF -f "$STATE/.files.new" | while read -r f; do
        [ -n "$f" ] || continue
        rm -f "$USERINIT/$f" && echo "removed $f (no longer in Flipfull)"
        (cd "$USERINIT" && rmdir -p "$(dirname "$f")" 2>/dev/null)
    done
    rm -f "$STATE/.files.new"
    cp "$src/.files" "$MANIFEST"
    echo "$(wc -l < "$STATE/changed") of $(grep -vc '^#' "$src/.files") files changed"
}

cmd_setup() {
    if [ "$1" = --from ]; then
        [ -n "$2" ] || die "usage: flipfull setup [--from DIR]"
        sync_from "$(cd "$2" && pwd)"
        exec sh "$USERINIT/flipfull" setup
    fi
    [ -f "$REGISTRY" ] || die "$USERINIT isn't installed"
    mkdir -p "$CONFIG" "$STATE"

    chown -R root:root "$USERINIT"
    find "$USERINIT" -type d -exec chmod 0711 {} \;
    find "$USERINIT" -type f -exec chmod 0644 {} \;
    find "$USERINIT" -type f \( -name '*.sh' -o -path '*/bin/*' -o -path '*/cgi-bin/*' -o -name flipfull \
         -o -name stt-server -o -name callrecd \) -exec chmod 0755 {} \;
    [ -f "$GOOGLE_CLIENT" ] && chmod 0600 "$GOOGLE_CLIENT"
    for src in "$USERINIT"/overlays/*; do
        dst=$(readlink -f "$VROOT/${src##*/}" 2>/dev/null)
        [ -f "$src/application.zip" ] && [ -n "$dst" ] && [ -d "$dst" ] || continue
        chmod 0755 "$src" && chmod 0644 "$src"/*
        ctx=$(ls -Zd "$dst" 2>/dev/null | awk '{ print $1 }')
        case $ctx in u:object_r:*) chcon -R "$ctx" "$src" ;; esac
    done

    publish || echo "error: couldn't write features.js in $(http_root)"

    changed=$(cat "$STATE/changed" 2>/dev/null)
    now=$(plan)
    reconcile_services "$now" $(echo "$changed" | sed -n 's|^services/\([^/]*\)/.*|\1|p' | sort -u)
    reconcile_apps "$now" $(echo "$changed" | sed -n 's|^[a-z]*/\([^/]*\)/application.zip$|\1|p')
    reconcile_store "$now"

    hook_file >/dev/null ||
        echo "WARNING: no boot hook runs $USERINIT/run.sh - nothing here starts at boot (src/boot-hook/README.md)"
    version
    cmd_state | awk -F '\t' '$1 == "reboot" && $2 == "yes" {
        print "Some features apply at the next boot: reboot the phone" }'
}

cmd_uninstall() {
    touch "$USERINIT/uninstall"
    for s in "$USERINIT"/services/*/service.sh; do
        case $s in */toolbox/*) continue ;; esac
        sh "$s" stop
    done
    list=$(apps_cmd list)
    for d in "$USERINIT"/apps/*/; do
        name=$(basename "$d")
        url=$(app_url "$name") || continue
        [ "$name" = flipfull ] && continue
        case $list in *"$url"*)
            apps_ok "$(apps_cmd uninstall "$url")" && echo "uninstalled $name" || echo "error: $name didn't uninstall" ;;
        esac
    done
    url=http://$STORE_ORIGIN.localhost/manifest.webmanifest
    case $list in *"$url"*)
        apps_ok "$(apps_cmd uninstall "$url")" && echo "uninstalled Flipstore" || echo "error: Flipstore didn't uninstall" ;;
    esac
    echo "Everything else is removed at the next boot (preloaded apps you made removable go back"
    echo "to stock); the phone then boots stock. Changed your mind before rebooting? Install again."
    url=$(app_url flipfull)
    if [ "$1" = --reboot ]; then
        setsid sh -c "sleep 1; echo '{\"cmd\":\"uninstall\",\"param\":\"$url\"}' | nc -U -W 60 $APPS_SOCK;
                      sh $USERINIT/services/toolbox/service.sh stop; sync; reboot" </dev/null >/dev/null 2>&1 &
    else
        case $list in *"$url"*) apps_cmd uninstall "$url" >/dev/null && echo "uninstalled the Flipfull app" ;; esac
        sh "$USERINIT/services/toolbox/service.sh" stop
    fi
}

update_step() { echo "running $$ $*" > "$STATE/update"; }

update_failed() {
    echo "error: $*"
    echo "failed $*" > "$STATE/update"
    rm -rf "$UPDATE_DIR"
    exit 1
}

cmd_update() {
    case $1 in
        ''|status)
            read -r word rest 2>/dev/null < "$STATE/update" || word=none
            if [ "$word" = running ] && ! kill -0 "${rest%% *}" 2>/dev/null; then
                word=failed
                rest="the update stopped before it finished (did the phone restart?)"
            elif [ "$word" = running ]; then
                rest=${rest#* }
            fi
            printf 'update\t%s\t%s\n' "$word" "$rest"
            [ -f "$UPDATE_DIR/update.zip" ] && printf 'bytes\t%s\n' "$(stat -c %s "$UPDATE_DIR/update.zip")"
            tail -n 12 "$STATE/update.log" 2>/dev/null | awk '{ print "log\t" $0 }' ;;
        start)
            [ $# -eq 4 ] || die "usage: flipfull update start TAG ASSET SHA256"
            case $2 in ''|*[!A-Za-z0-9._-]*) die "not a release tag: $2" ;; esac
            case $3 in flipfull-*-update.zip) ;; *) die "not a Flipfull update: $3" ;; esac
            case $3 in *[!A-Za-z0-9._-]*) die "not a Flipfull update: $3" ;; esac
            echo "$4" | grep -qx '[0-9a-f]\{64\}' || die "not a sha256: $4"
            read -r word pid rest 2>/dev/null < "$STATE/update"
            [ "$word" = running ] && kill -0 "$pid" 2>/dev/null && die "an update is already running"
            mkdir -p "$STATE"
            rm -f "$STATE/update"
            : > "$STATE/update.log"
            setsid sh "$USERINIT/flipfull" update-run "$2" "$3" "$4" </dev/null >>"$STATE/update.log" 2>&1 &
            echo "started" ;;
        *)
            die "usage: flipfull update [status] | update start TAG ASSET SHA256" ;;
    esac
}

update_run() {
    update_step "Downloading"
    url=https://github.com/$RELEASE_REPO/releases/download/$1/$2
    echo "downloading $url"
    rm -rf "$UPDATE_DIR" && mkdir -p "$UPDATE_DIR" || update_failed "can't write $UPDATE_DIR"
    curl -fsSL --retry 2 --connect-timeout 20 -o "$UPDATE_DIR/update.zip" "$url" ||
        update_failed "couldn't download $2"
    [ "$(sha256sum "$UPDATE_DIR/update.zip" | cut -d' ' -f1)" = "$3" ] ||
        update_failed "the download doesn't match its checksum"
    update_step "Unpacking"
    unzip -q "$UPDATE_DIR/update.zip" -d "$UPDATE_DIR/files" || update_failed "couldn't unpack $2"
    rm -f "$UPDATE_DIR/update.zip"
    src=$(ls -d "$UPDATE_DIR"/files/*/flipfull 2>/dev/null | head -1)
    [ -f "$src/flipfull" ] && [ -f "$src/.files" ] || update_failed "$2 isn't a Flipfull update"
    update_step "Installing"
    sh "$src/flipfull" setup --from "$src" || update_failed "setup failed; see the log"
    rm -rf "$UPDATE_DIR"
    echo "done $(version)" > "$STATE/update"
}

STORE_RECORDS=$CONFIG/flipstore-apps

store_url_ok() { echo "$1" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&+,;=%-]+$'; }

store_official_url() {
    case $1 in
        "https://github.com/$STORE_REPO/releases/latest/download/flipstore.zip") return 0 ;;
        "https://github.com/$STORE_REPO/releases/download/"*"/flipstore.zip")
            tag=${1#"https://github.com/$STORE_REPO/releases/download/"}
            tag=${tag%/flipstore.zip}
            case $tag in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
            return 0 ;;
    esac
    return 1
}

store_record() {
    mkdir -p "$CONFIG"
    { grep -v "^$1 " "$STORE_RECORDS" 2>/dev/null; [ -z "$2" ] || echo "$1 $2"; } > "$STORE_RECORDS.tmp" &&
        mv -f "$STORE_RECORDS.tmp" "$STORE_RECORDS"
}

reconcile_store() {
    url=http://$STORE_ORIGIN.localhost/manifest.webmanifest
    list=$(apps_cmd list)
    apps_ok "$list" || return 0
    installed=0
    case $list in *"$url"*) installed=1 ;; esac
    if echo "$1" | grep -qx "feature flipstore on"; then
        [ $installed = 1 ] && return 0
        (store_stage "https://github.com/$STORE_REPO/releases/latest/download/flipstore.zip" >/dev/null) &&
            install_zip "$STORE_DIR/app.zip" Flipstore && store_record "$STORE_ORIGIN" official
        rm -rf "$STORE_DIR"
    elif [ $installed = 1 ]; then
        apps_ok "$(apps_cmd uninstall "$url")" && echo "uninstalled Flipstore" || echo "error: Flipstore didn't uninstall"
    fi
}

store_fetch() {
    code=$(curl -sL --connect-timeout 20 --max-time "$4" --max-filesize "$3" -o "$2" -w '%{http_code}' "$1")
    rc=$?
    [ $rc = 0 ] && [ "$code" = 200 ] && return 0
    case $rc:$code in
        63:*) echo "it's bigger than $(($3 / 1048576)) MB" ;;
        *:000) echo "no connection" ;;
        0:*) echo "HTTP $code" ;;
        *) echo "curl error $rc" ;;
    esac
    return 1
}

store_stage() {
    rm -rf "$STORE_DIR" && mkdir -p "$STORE_DIR" && chmod 0700 "$STORE_DIR" || die "can't write $STORE_DIR"
    echo "$1" > "$STORE_DIR/url"
    why=$(store_fetch "$1" "$STORE_DIR/app.zip" $STORE_MAX 300) || die "couldn't download $1: $why"
    sum=$(sha256sum "$STORE_DIR/app.zip" | cut -d' ' -f1)
    if [ -n "$2" ] && [ "$2" != "$sum" ]; then
        rm -rf "$STORE_DIR"
        die "the download doesn't match its checksum"
    fi
    unzip -p "$STORE_DIR/app.zip" manifest.webmanifest > "$STORE_DIR/manifest.webmanifest" 2>/dev/null
    [ -s "$STORE_DIR/manifest.webmanifest" ] || die "not a KaiOS app: the zip has no manifest.webmanifest"
    printf 'sha256\t%s\nsize\t%s\nmanifest\n' "$sum" "$(stat -c %s "$STORE_DIR/app.zip")"
    cat "$STORE_DIR/manifest.webmanifest"
}

flipfull_apps() {
    for m in "$USERINIT"/apps/*/manifest.webmanifest; do
        json_value origin < "$m"
    done
    ls "$USERINIT/overlays" 2>/dev/null
}

store_protected() {
    pre=$(preloaded_apps)
    [ -n "$pre" ] || die "can't read the phone's app list"
    echo "$pre"
    flipfull_apps
}

store_name_ok() { case $1 in ''|-*|*[!a-z0-9.-]*) return 1 ;; esac; }

cmd_store() {
    plan | grep -qx "feature flipstore on" || die "turn on Flipstore app store in the Flipfull app first"
    case $1 in
        info)
            printf 'store-repo\t%s\n' "$STORE_REPO" ;;
        get)
            store_url_ok "$2" || die "not an https URL: $2"
            tmp=$STORE_DIR-get.$$
            why=$(store_fetch "$2" "$tmp" 2097152 60) || {
                rm -f "$tmp"
                die "couldn't get $2: $why"
            }
            cat "$tmp"
            rm -f "$tmp" ;;
        stage)
            store_url_ok "$2" || die "not an https URL: $2"
            [ -z "$3" ] || echo "$3" | grep -qx '[0-9a-f]\{64\}' || die "not a sha256: $3"
            store_stage "$2" "$3" ;;
        install)
            [ $# -eq 3 ] || die "usage: flipfull store install ORIGIN SOURCE"
            [ -f "$STORE_DIR/app.zip" ] || die "nothing downloaded to install"
            m=$STORE_DIR/manifest.webmanifest
            grep -q '\\u' "$m" && die "the app's manifest has \\u escapes; Flipstore can't check which app it is"
            [ "$(grep -o '"origin"' "$m" | wc -l)" -eq 1 ] || die "the app's manifest names more than one origin"
            origin=$(json_value origin < "$m")
            store_name_ok "$origin" || die "the app's manifest has no usable origin"
            [ "$origin" = "$2" ] || die "the download is $origin, not $2"
            protected=$(store_protected) || exit 1
            echo "$protected" | grep -qx "$origin" &&
                die "$origin is one of the phone's or Flipfull's own apps; Flipstore won't replace it"
            source=$3
            if [ "$origin" = "$STORE_ORIGIN" ]; then
                store_official_url "$(cat "$STORE_DIR/url")" ||
                    die "Flipstore only updates from github.com/$STORE_REPO"
                source=official
            else
                store_url_ok "$source" || die "not a source: $source"
            fi
            install_zip "$STORE_DIR/app.zip" "$origin" || exit 1
            store_record "$origin" "$source"
            rm -rf "$STORE_DIR" ;;
        uninstall)
            store_name_ok "$2" || die "not an app name: $2"
            [ "$2" = "$STORE_ORIGIN" ] && die "turn off Flipstore app store in the Flipfull app to remove Flipstore"
            protected=$(store_protected) || exit 1
            echo "$protected" | grep -qx "$2" && die "$2 is one of the phone's or Flipfull's own apps"
            apps_ok "$(apps_cmd uninstall "http://$2.localhost/manifest.webmanifest")" || die "$2 didn't uninstall"
            store_record "$2"
            echo "uninstalled $2" ;;
        installed)
            ours=$(flipfull_apps)
            "$SQLITE" -init /dev/null -separator ' ' "$APPS_DB" \
                "SELECT name, preloaded, IFNULL(NULLIF(update_url, ''), '-') FROM apps
                 WHERE preloaded = 0 OR IFNULL(update_url, '') != '' ORDER BY name" |
            while read -r name preloaded update; do
                source=$(awk -v n="$name" '$1 == n { print $2 }' "$STORE_RECORDS" 2>/dev/null)
                mine=0
                echo "$ours" | grep -qx "$name" && mine=1
                [ -z "$source" ] && [ $mine = 1 ] && [ "$preloaded" = 0 ] && source=flipfull
                manifest=$(app_manifest "$name")
                printf 'app\t%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$(echo "$manifest" | json_value name)" \
                    "$(echo "$manifest" | json_value version)" "$update" "${source:--}" \
                    "$([ "$preloaded" = 1 ] || [ $mine = 1 ] && echo 1 || echo 0)"
            done ;;
        *)
            die "usage: flipfull store info | get URL | stage URL [SHA256] | install ORIGIN SOURCE | uninstall NAME | installed" ;;
    esac
}

cmd_status() {
    version
    f=$(hook_file) && echo "boot hook: $f" ||
        echo "boot hook: MISSING - nothing here runs at boot (src/boot-hook/README.md)"
    [ -e "$USERINIT/uninstall" ] && echo "uninstall pending: the next boot removes everything"
    echo
    cmd_state | awk -F '\t' '
        $1 == "reboot" && $2 == "yes" { waiting = 1 }
        $1 == "removable" && $2 == "pending" { print "removable apps: changed, the next boot applies it" }
        $1 == "google-client" { print "Google sign-in client: " ($2 == "-" ? "none" : $2) }
        $1 == "feature" {
            line = sprintf("  [%s] %s", $3 == "on" ? "x" : " ", $2)
            if ($5 == "yes") line = line "  (after a reboot)"
            if ($6 != "yes") line = line "  - " ($6 == "no" ? "unusable" : "partly") ": " $7
            features = features line "\n"
        }
        END { printf "\nfeatures%s:\n%s", waiting ? " (some wait for a reboot)" : "", features }'
    echo
    echo "mounted:"
    awk '$4 ~ /userinit\/(overlays|media|state|etc)/ { print "  " $5 "  <-  " $4 }' /proc/self/mountinfo
    echo
    echo "services:"
    for s in "$USERINIT"/services/*/service.sh; do
        sh "$s" status
    done
    echo
    echo "updaters (stopped after boot while block-updates is on):"
    for s in update_engine updater-daemon; do
        echo "  $s: $(getprop init.svc.$s)"
    done
    echo
    echo "last boot:"
    tail -15 "$USERINIT/run.log" 2>/dev/null
}

cmd=$1
[ $# -gt 0 ] && shift
case $cmd in
    features) cat "$REGISTRY" ;;
    state) cmd_state ;;
    set) cmd_set "$@" ;;
    plan) plan ;;
    publish)
        if [ "$1" = --remove ]; then
            rm -rf "$(http_root)/flipfull"
        else
            publish
        fi ;;
    removable) cmd_removable "$@" ;;
    google-client) cmd_google_client "$@" ;;
    status) cmd_status ;;
    log) tail -n "${1:-200}" "$USERINIT/run.log" ;;
    restart) sh "$USERINIT/tools/restart.sh" "$@" ;;
    reboot)
        echo "rebooting"
        setsid sh -c 'sleep 1; sync; reboot' </dev/null >/dev/null 2>&1 & ;;
    install-app)
        [ -f "$1" ] || die "usage: flipfull install-app ZIP"
        install_zip "$1" "$(basename "$1" .zip)" ;;
    setup) cmd_setup "$@" ;;
    update) cmd_update "$@" ;;
    update-run) update_run "$@" ;;
    store) cmd_store "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *) usage; exit 2 ;;
esac
